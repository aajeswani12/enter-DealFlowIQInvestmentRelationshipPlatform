create or replace function public.guard_outreach_contact()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_contact_investor uuid;
  v_permission text;
begin
  if new.contact_id is null then
    return new;
  end if;

  select c.investor_id, c.outreach_permission_status
    into v_contact_investor, v_permission
  from public.investor_contacts c
  where c.id = new.contact_id;

  if v_contact_investor is null then
    return new;
  end if;

  if v_contact_investor <> new.investor_id then
    raise exception 'Outreach contact does not belong to this investor' using errcode = '23514';
  end if;

  if v_permission = 'do_not_contact' then
    raise exception 'This contact is marked do-not-contact' using errcode = '42501';
  end if;

  return new;
end;
$$;

create trigger outreach_actions_contact_guard
before insert or update of contact_id, investor_id on public.outreach_actions
for each row execute function public.guard_outreach_contact();

revoke all on function public.guard_outreach_contact() from public, anon, authenticated;
