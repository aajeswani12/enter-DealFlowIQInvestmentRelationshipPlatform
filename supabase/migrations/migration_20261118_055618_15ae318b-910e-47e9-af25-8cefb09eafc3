-- Membership layer: investment data is visible only to authorized workspace members.
create table public.workspace_members (
  id uuid primary key default gen_random_uuid(),
  user_id uuid unique,
  email text not null,
  display_name text not null default '',
  role text not null default 'analyst' check (role in ('owner','partner','analyst','viewer')),
  status text not null default 'invited' check (status in ('invited','active','revoked')),
  invited_by uuid,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create unique index workspace_members_email_key on public.workspace_members (lower(email));
create index workspace_members_user_idx on public.workspace_members (user_id);

alter table public.workspace_members enable row level security;

create or replace function public.is_project_member()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.workspace_members m
    where m.user_id = auth.uid() and m.status = 'active'
  );
$$;

create or replace function public.current_member_role()
returns text
language sql
stable
security definer
set search_path = public
as $$
  select m.role from public.workspace_members m
  where m.user_id = auth.uid() and m.status = 'active'
  limit 1;
$$;

create or replace function public.can_write_project()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.workspace_members m
    where m.user_id = auth.uid()
      and m.status = 'active'
      and m.role in ('owner','partner','analyst')
  );
$$;

create or replace function public.is_project_admin()
returns boolean
language sql
stable
security definer
set search_path = public
as $$
  select exists (
    select 1 from public.workspace_members m
    where m.user_id = auth.uid()
      and m.status = 'active'
      and m.role in ('owner','partner')
  );
$$;

create or replace function public.claim_workspace()
returns text
language plpgsql
security definer
set search_path = public
as $$
declare
  v_uid uuid := auth.uid();
  v_email text;
  v_role text;
begin
  if v_uid is null then
    return null;
  end if;

  select lower(u.email) into v_email from auth.users u where u.id = v_uid;
  if v_email is null then
    return null;
  end if;

  select m.role into v_role
  from public.workspace_members m
  where m.user_id = v_uid and m.status = 'active';
  if v_role is not null then
    return v_role;
  end if;

  -- Serialize first-member bootstrap and invitation activation.
  perform pg_advisory_xact_lock(918273645);

  update public.workspace_members m
     set user_id = v_uid,
         status = 'active',
         updated_at = now()
   where lower(m.email) = v_email
     and m.status = 'invited'
     and m.user_id is null
   returning m.role into v_role;
  if v_role is not null then
    return v_role;
  end if;

  if not exists (select 1 from public.workspace_members where status = 'active') then
    insert into public.workspace_members (user_id, email, role, status)
    values (v_uid, v_email, 'owner', 'active')
    on conflict do nothing;

    select m.role into v_role
    from public.workspace_members m
    where m.user_id = v_uid and m.status = 'active';
    return v_role;
  end if;

  return null;
end;
$$;

create or replace function public.guard_workspace_member_update()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_other_owners int;
begin
  -- Partners may invite and revoke, but only owners assign roles.
  if new.role is distinct from old.role and public.current_member_role() = 'partner' then
    raise exception 'Only a workspace owner can change a member role';
  end if;

  if old.role = 'owner' and (new.role is distinct from 'owner' or new.status is distinct from 'active') then
    select count(*) into v_other_owners
    from public.workspace_members
    where role = 'owner' and status = 'active' and id <> old.id;
    if v_other_owners = 0 then
      raise exception 'The workspace must keep at least one active owner';
    end if;
  end if;

  new.updated_at := now();
  return new;
end;
$$;

create trigger workspace_members_guard
before update on public.workspace_members
for each row execute function public.guard_workspace_member_update();

create policy workspace_members_select on public.workspace_members
for select to authenticated
using (user_id = auth.uid() or public.is_project_admin());

create policy workspace_members_insert on public.workspace_members
for insert to authenticated
with check (public.is_project_admin());

create policy workspace_members_update on public.workspace_members
for update to authenticated
using (public.is_project_admin())
with check (public.is_project_admin());

create policy workspace_members_delete on public.workspace_members
for delete to authenticated
using (public.is_project_admin() and user_id is distinct from auth.uid() and role <> 'owner');

revoke all on function public.is_project_member() from public;
revoke all on function public.current_member_role() from public;
revoke all on function public.can_write_project() from public;
revoke all on function public.is_project_admin() from public;
revoke all on function public.claim_workspace() from public;
grant execute on function public.is_project_member() to authenticated;
grant execute on function public.current_member_role() to authenticated;
grant execute on function public.can_write_project() to authenticated;
grant execute on function public.is_project_admin() to authenticated;
grant execute on function public.claim_workspace() to authenticated;
