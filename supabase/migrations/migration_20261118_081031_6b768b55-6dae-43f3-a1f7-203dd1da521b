create table public.import_batches (
  id uuid primary key default gen_random_uuid(),
  label text not null,
  status text not null default 'uploading' check (status in ('uploading','processing','review','completed','failed')),
  is_synthetic boolean not null default false,
  total_files integer not null default 0,
  files_processed integer not null default 0,
  records_processed integer not null default 0,
  records_needing_review integer not null default 0,
  error_count integer not null default 0,
  notes text not null default '',
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.import_files (
  id uuid primary key default gen_random_uuid(),
  batch_id uuid not null references public.import_batches(id),
  file_name text not null,
  file_type text not null check (file_type in ('csv','pdf','docx','txt','email')),
  mime_type text not null default '',
  size_bytes bigint not null check (size_bytes > 0),
  storage_path text not null,
  checksum text not null default '',
  processing_status text not null default 'pending'
    check (processing_status in ('pending','extracting','needs_review','completed','failed','duplicate')),
  records_processed integer not null default 0,
  records_needing_review integer not null default 0,
  error_message text not null default '',
  extracted_text text not null default '',
  extracted_char_count integer not null default 0,
  page_count integer not null default 0,
  duplicate_of uuid references public.import_files(id),
  source_date timestamptz not null default now(),
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.case_documents (
  id uuid primary key default gen_random_uuid(),
  deal_id uuid not null references public.deals(id),
  import_file_id uuid not null references public.import_files(id),
  batch_id uuid not null references public.import_batches(id),
  title text not null,
  document_type text not null check (document_type in ('csv','pdf','docx','txt','email')),
  source_date timestamptz not null default now(),
  storage_path text not null,
  file_name text not null,
  mime_type text not null default '',
  extracted_text text not null default '',
  excerpt text not null default '',
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  unique (import_file_id, deal_id)
);

create table public.import_candidates (
  id uuid primary key default gen_random_uuid(),
  batch_id uuid not null references public.import_batches(id),
  file_id uuid not null references public.import_files(id),
  entity_type text not null check (entity_type in ('deal','investor','claim')),
  status text not null default 'pending'
    check (status in ('pending','needs_review','applied','rejected','kept_separate')),
  deal_id uuid references public.deals(id),
  investor_id uuid references public.investors(id),
  proposed_deal_id uuid references public.deals(id),
  proposed_investor_id uuid references public.investors(id),
  parent_candidate_id uuid references public.import_candidates(id),
  match_confidence text not null default 'none'
    check (match_confidence in ('exact','high','medium','low','none')),
  match_basis text not null default '',
  payload jsonb not null default '{}'::jsonb,
  excerpt text not null default '',
  source_date timestamptz,
  fingerprint text not null,
  conflict_summary text not null default '',
  review_note text not null default '',
  reviewed_by uuid,
  reviewed_at timestamptz,
  applied_record_id uuid,
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (file_id, entity_type, fingerprint)
);

create table public.import_reviews (
  id uuid primary key default gen_random_uuid(),
  candidate_id uuid not null references public.import_candidates(id),
  batch_id uuid not null references public.import_batches(id),
  action text not null check (action in ('approve','edit','reject','keep_separate')),
  before jsonb not null default '{}'::jsonb,
  after jsonb not null default '{}'::jsonb,
  note text not null default '',
  reviewer uuid default auth.uid(),
  created_at timestamptz not null default now()
);

create table public.follow_up_tasks (
  id uuid primary key default gen_random_uuid(),
  deal_id uuid not null references public.deals(id),
  investor_id uuid references public.investors(id),
  title text not null,
  detail text not null default '',
  due_date timestamptz,
  status text not null default 'open' check (status in ('open','done','dismissed')),
  source_document_id uuid references public.case_documents(id),
  import_candidate_id uuid references public.import_candidates(id),
  owner_user_id uuid,
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

alter table public.investors add column website text not null default '';
alter table public.deal_claims add column document_id uuid references public.case_documents(id);
alter table public.investor_interactions add column document_id uuid references public.case_documents(id);
alter table public.decision_gaps add column document_id uuid references public.case_documents(id);
alter table public.decision_gaps drop constraint decision_gaps_origin_check;
alter table public.decision_gaps add constraint decision_gaps_origin_check check (origin in ('manual','analysis','import'));

create index import_files_batch_idx on public.import_files (batch_id, created_at desc);
create index import_files_checksum_idx on public.import_files (checksum) where checksum <> '';
create index import_candidates_file_idx on public.import_candidates (file_id, status);
create index import_candidates_batch_idx on public.import_candidates (batch_id, status);
create index case_documents_deal_idx on public.case_documents (deal_id, source_date);
create index case_documents_file_idx on public.case_documents (import_file_id);
create index follow_up_tasks_deal_idx on public.follow_up_tasks (deal_id, status, due_date);
create index import_reviews_candidate_idx on public.import_reviews (candidate_id, created_at desc);

alter table public.import_batches enable row level security;
alter table public.import_files enable row level security;
alter table public.import_candidates enable row level security;
alter table public.import_reviews enable row level security;
alter table public.case_documents enable row level security;
alter table public.follow_up_tasks enable row level security;

