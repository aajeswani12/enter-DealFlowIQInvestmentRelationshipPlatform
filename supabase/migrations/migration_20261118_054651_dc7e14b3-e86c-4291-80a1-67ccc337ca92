-- DealFlow IQ core schema
create table public.investment_cases (
  id uuid primary key default gen_random_uuid(),
  company_name text not null,
  one_liner text not null default '',
  sector text not null default '',
  geography text not null default '',
  round_stage text not null default '',
  status text not null default 'sourcing' check (status in ('sourcing','diligence','ic_review','term_sheet','invested','passed')),
  raise_amount numeric,
  cheque_sought numeric,
  pre_money_valuation numeric,
  ownership_target numeric,
  lead_required boolean not null default true,
  lead_partner text not null default '',
  referred_by text not null default '',
  thesis text not null default '',
  next_step text not null default '',
  next_step_due timestamptz,
  capture_id uuid,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);

create table public.deal_inbox_items (
  id uuid primary key default gen_random_uuid(),
  company_name text not null,
  founder_name text not null default '',
  founder_email text not null default '',
  sector text not null default '',
  round_stage text not null default '',
  source text not null default 'voice' check (source in ('voice','text')),
  notes text not null default '',
  audio_url text,
  audio_path text,
  duration_seconds integer,
  status text not null default 'new' check (status in ('new','reviewing','promoted','archived')),
  referred_by text not null default '',
  case_id uuid references public.investment_cases(id) on delete set null,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now()
);

alter table public.investment_cases
  add constraint investment_cases_capture_fk foreign key (capture_id) references public.deal_inbox_items(id) on delete set null;

create table public.case_evidence (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references public.investment_cases(id) on delete cascade,
  kind text not null default 'metric' check (kind in ('metric','document','call_note','reference')),
  title text not null,
  detail text not null default '',
  file_name text,
  file_path text,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now()
);

create table public.case_questions (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references public.investment_cases(id) on delete cascade,
  question text not null,
  owner text not null default '',
  status text not null default 'open' check (status in ('open','answered')),
  answer text not null default '',
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now(),
  resolved_at timestamptz
);

create table public.investors (
  id uuid primary key default gen_random_uuid(),
  firm_name text not null,
  contact_name text not null default '',
  email text not null default '',
  investor_type text not null default 'vc' check (investor_type in ('vc','angel','family_office','corporate')),
  stages text[] not null default '{}',
  sectors text[] not null default '{}',
  geographies text[] not null default '{}',
  check_min numeric,
  check_max numeric,
  leads_rounds boolean not null default false,
  relationship text not null default 'new' check (relationship in ('new','warm','active','dormant')),
  notes text not null default '',
  last_contact_at timestamptz,
  next_step text not null default '',
  next_step_due timestamptz,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now()
);

create table public.investor_interactions (
  id uuid primary key default gen_random_uuid(),
  investor_id uuid not null references public.investors(id) on delete cascade,
  case_id uuid references public.investment_cases(id) on delete set null,
  kind text not null default 'call' check (kind in ('intro','call','email','meeting','note')),
  summary text not null,
  occurred_at timestamptz not null default now(),
  next_step text not null default '',
  next_step_due timestamptz,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now()
);

create table public.outreach_messages (
  id uuid primary key default gen_random_uuid(),
  case_id uuid not null references public.investment_cases(id) on delete cascade,
  investor_id uuid not null references public.investors(id) on delete cascade,
  subject text not null,
  body text not null,
  channel text not null default 'email' check (channel in ('email','linkedin','intro')),
  status text not null default 'draft' check (status in ('draft','approved','sent')),
  approved_at timestamptz,
  sent_at timestamptz,
  created_by uuid not null default auth.uid(),
  created_at timestamptz not null default now()
);

create index investment_cases_status_idx on public.investment_cases(status);
create index deal_inbox_items_created_idx on public.deal_inbox_items(created_at desc);
create index case_evidence_case_idx on public.case_evidence(case_id);
create index case_questions_case_idx on public.case_questions(case_id);
create index investor_interactions_investor_idx on public.investor_interactions(investor_id);
create index outreach_messages_case_idx on public.outreach_messages(case_id);
create index outreach_messages_investor_idx on public.outreach_messages(investor_id);

