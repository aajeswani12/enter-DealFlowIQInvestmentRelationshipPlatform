create table public.deal_investors (
  id uuid primary key default gen_random_uuid(),
  deal_id uuid not null references public.deals(id) on delete cascade,
  investor_id uuid not null references public.investors(id) on delete cascade,
  relationship_status text not null default 'new' check (relationship_status in ('new','warm','active','dormant')),
  notes text not null default '',
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now(),
  unique (deal_id, investor_id)
);
create index deal_investors_deal_idx on public.deal_investors (deal_id, created_at desc);
create index deal_investors_investor_idx on public.deal_investors (investor_id);
alter table public.deal_investors enable row level security;
create policy deal_investors_select on public.deal_investors for select to authenticated using (public.is_project_member());
create policy deal_investors_insert on public.deal_investors for insert to authenticated with check (public.can_write_project());
create policy deal_investors_update on public.deal_investors for update to authenticated using (public.can_write_project()) with check (public.can_write_project());
create policy deal_investors_delete on public.deal_investors for delete to authenticated using (public.can_write_project());

create table public.deal_memos (
  id uuid primary key default gen_random_uuid(),
  deal_id uuid not null references public.deals(id) on delete cascade,
  title text not null default '',
  content text not null default '',
  status text not null default 'draft' check (status in ('draft','approved')),
  created_by uuid default auth.uid(),
  updated_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index deal_memos_deal_idx on public.deal_memos (deal_id, updated_at desc);
alter table public.deal_memos enable row level security;
create policy deal_memos_select on public.deal_memos for select to authenticated using (public.is_project_member());
create policy deal_memos_insert on public.deal_memos for insert to authenticated with check (public.can_write_project());
create policy deal_memos_update on public.deal_memos for update to authenticated using (public.can_write_project()) with check (public.can_write_project());

alter table public.case_documents alter column import_file_id drop not null;
alter table public.case_documents alter column batch_id drop not null;
