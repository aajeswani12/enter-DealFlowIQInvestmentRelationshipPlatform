create table if not exists public.memo_templates (
  id uuid primary key default gen_random_uuid(),
  name text not null,
  storage_path text not null,
  file_name text not null,
  file_type text not null check (file_type in ('pdf','docx','txt','email','csv')),
  headings jsonb not null default '[]'::jsonb,
  style_notes text not null default '',
  length_guidance text not null default '',
  status text not null default 'proposed' check (status in ('proposed','active')),
  created_by uuid,
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index if not exists memo_templates_status_idx on public.memo_templates (status, updated_at desc);
alter table public.memo_templates enable row level security;
create policy memo_templates_member_select on public.memo_templates for select to authenticated using (public.is_project_member());
create policy memo_templates_writer_insert on public.memo_templates for insert to authenticated with check (public.can_write_project());
create policy memo_templates_writer_update on public.memo_templates for update to authenticated using (public.can_write_project()) with check (public.can_write_project());

alter table public.deal_memos
  add column if not exists template_kind text not null default 'internal',
  add column if not exists template_id uuid references public.memo_templates(id) on delete set null,
  add column if not exists focus_areas text[] not null default '{}'::text[];

alter table public.deal_memos drop constraint if exists deal_memos_status_check;
alter table public.deal_memos add constraint deal_memos_status_check check (status in ('draft','needs_review','approved'));
alter table public.deal_memos drop constraint if exists deal_memos_template_kind_check;
alter table public.deal_memos add constraint deal_memos_template_kind_check check (template_kind in ('internal','external','custom'));

alter table public.deal_memo_versions
  add column if not exists template_kind text not null default 'internal',
  add column if not exists template_id uuid references public.memo_templates(id) on delete set null,
  add column if not exists focus_areas text[] not null default '{}'::text[];

alter table public.deal_memo_versions drop constraint if exists deal_memo_versions_template_kind_check;
alter table public.deal_memo_versions add constraint deal_memo_versions_template_kind_check check (template_kind in ('internal','external','custom'));

create or replace function public.snapshot_deal_memo_version()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_next integer;
begin
  if tg_op = 'UPDATE'
     and new.content is not distinct from old.content
     and new.title is not distinct from old.title
     and new.origin is not distinct from old.origin
     and new.generation_model is not distinct from old.generation_model
     and new.source_ids is not distinct from old.source_ids
     and new.approved_proposal_ids is not distinct from old.approved_proposal_ids
     and new.human_edited is not distinct from old.human_edited
     and new.template_kind is not distinct from old.template_kind
     and new.template_id is not distinct from old.template_id
     and new.focus_areas is not distinct from old.focus_areas then
    return new;
  end if;

  select coalesce(max(version_number), 0) + 1 into v_next
  from public.deal_memo_versions where memo_id = new.id;

  insert into public.deal_memo_versions (
    memo_id, deal_id, version_number, title, content, origin, generation_model,
    source_ids, approved_proposal_ids, human_edited, edited_by, created_by,
    template_kind, template_id, focus_areas
  ) values (
    new.id, new.deal_id, v_next, new.title, new.content, coalesce(new.origin, 'manual'),
    coalesce(new.generation_model, ''), coalesce(new.source_ids, '{}'::uuid[]),
    coalesce(new.approved_proposal_ids, '{}'::uuid[]), coalesce(new.human_edited, false),
    new.edited_by, coalesce(new.updated_by, new.created_by),
    coalesce(new.template_kind, 'internal'), new.template_id, coalesce(new.focus_areas, '{}'::text[])
  );
  return new;
end;
$$;

create or replace function public.guard_deal_memo_status()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  if current_setting('app.memo_approval', true) = 'on' then
    return new;
  end if;
  if new.content is distinct from old.content
     or new.title is distinct from old.title
     or new.template_kind is distinct from old.template_kind
     or new.template_id is distinct from old.template_id
     or new.focus_areas is distinct from old.focus_areas then
    new.status := 'draft';
    return new;
  end if;
  if new.status is distinct from old.status then
    raise exception 'Memo approval status can only be changed by an authorized approval action.' using errcode = '42501';
  end if;
  return new;
end;
$$;

create trigger deal_memos_status_guard
before update on public.deal_memos
for each row execute function public.guard_deal_memo_status();

