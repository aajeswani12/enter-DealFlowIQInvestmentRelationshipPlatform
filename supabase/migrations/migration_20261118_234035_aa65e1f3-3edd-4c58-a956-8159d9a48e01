create index if not exists deal_memo_approvals_version_idx on public.deal_memo_approvals (version_id, created_at desc);
create index if not exists deal_memo_approvals_memo_idx on public.deal_memo_approvals (memo_id, created_at desc);
alter table public.deal_memo_approvals enable row level security;
create policy deal_memo_approvals_member_select on public.deal_memo_approvals for select to authenticated using (public.is_project_member());

