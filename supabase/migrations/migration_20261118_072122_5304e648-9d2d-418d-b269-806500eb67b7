-- Workspace-wide, user-editable scoring weights.
create table public.match_weight_configs (
  id uuid primary key default gen_random_uuid(),
  sector_thesis integer not null default 30 check (sector_thesis between 0 and 100),
  stage integer not null default 25 check (stage between 0 and 100),
  check_size integer not null default 20 check (check_size between 0 and 100),
  geography integer not null default 10 check (geography between 0 and 100),
  relationship integer not null default 10 check (relationship between 0 and 100),
  recent_interest integer not null default 5 check (recent_interest between 0 and 100),
  updated_by uuid,
  updated_at timestamptz not null default now(),
  check (sector_thesis + stage + check_size + geography + relationship + recent_interest = 100)
);

alter table public.match_weight_configs enable row level security;
create policy match_weight_configs_select on public.match_weight_configs
for select to authenticated using (public.is_project_member());
create policy match_weight_configs_insert on public.match_weight_configs
for insert to authenticated with check (public.can_write_project());
create policy match_weight_configs_update on public.match_weight_configs
for update to authenticated using (public.can_write_project()) with check (public.can_write_project());
create policy match_weight_configs_delete on public.match_weight_configs
for delete to authenticated using (public.is_project_admin());

create trigger match_weight_configs_touch before update on public.match_weight_configs
for each row execute function public.touch_updated_at();

