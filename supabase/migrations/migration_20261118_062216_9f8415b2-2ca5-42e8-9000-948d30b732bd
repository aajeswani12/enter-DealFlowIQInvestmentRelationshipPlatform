alter table public.sources
  add column client_capture_id uuid,
  add column original_transcript text not null default '',
  add column transcription_status text not null default 'not_requested'
    check (transcription_status in ('not_requested','processing','completed','failed','unavailable','manual')),
  add column transcription_provider text not null default '',
  add column transcription_model text not null default '',
  add column transcription_error text not null default '',
  add column extraction_status text not null default 'not_requested'
    check (extraction_status in ('not_requested','processing','completed','failed','unavailable')),
  add column extraction_error text not null default '',
  add column extracted_fields jsonb not null default '{}'::jsonb,
  add column audio_mime_type text not null default '',
  add column audio_size_bytes bigint check (audio_size_bytes is null or audio_size_bytes > 0),
  add column processed_at timestamptz;

create unique index sources_client_capture_id_key
  on public.sources (client_capture_id)
  where client_capture_id is not null;

create index sources_transcription_status_idx on public.sources (transcription_status);
