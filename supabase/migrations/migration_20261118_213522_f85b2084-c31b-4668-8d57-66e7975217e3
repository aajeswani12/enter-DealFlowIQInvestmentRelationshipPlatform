create index if not exists case_fact_proposals_deal_status_idx on public.case_fact_proposals (deal_id, status, created_at desc);
create index if not exists case_fact_proposals_source_idx on public.case_fact_proposals (source_key, created_at desc);
alter table public.case_fact_proposals enable row level security;
create policy case_fact_proposals_member_select on public.case_fact_proposals
