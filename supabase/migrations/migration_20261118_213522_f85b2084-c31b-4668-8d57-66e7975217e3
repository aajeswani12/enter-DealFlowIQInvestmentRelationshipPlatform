  deal_id uuid not null references public.deals(id) on delete cascade,
  source_key text not null,
  source_kind text not null check (source_kind in ('capture','document')),
  source_capture_id uuid references public.sources(id) on delete set null,
  source_document_id uuid references public.case_documents(id) on delete set null,
  source_title text not null default '',
  source_date timestamptz not null,
  source_excerpt text not null,
  source_reference text not null default '',
  relation text not null check (relation in ('new','changed','clarification','conflict')),
  previous_claim_id uuid references public.deal_claims(id) on delete set null,
  previous_value_text text not null default '',
  previous_period text not null default '',
  previous_currency text not null default '',
  claim_type text not null,
  label text not null,
  value_text text not null,
  normalized_value numeric,
  currency text not null default 'USD',
  reporting_period text not null default '',
  metric_definition text not null default '',
  attribution text not null default 'unknown' check (attribution in ('founder','third_party','unknown')),
  confidence text not null default 'medium' check (confidence in ('high','medium','low')),
  status text not null default 'pending' check (status in ('pending','accepted','rejected')),
  edited boolean not null default false,
  review_note text not null default '',
  reviewed_by uuid,
  reviewed_at timestamptz,
  applied_claim_id uuid references public.deal_claims(id) on delete set null,
  generation_model text not null default '',
