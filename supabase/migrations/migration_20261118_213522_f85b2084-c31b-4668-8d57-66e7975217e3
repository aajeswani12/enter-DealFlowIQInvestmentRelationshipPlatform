create or replace function public.touch_case_fact_proposal()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
begin
  new.updated_at = now();
  return new;
end;
$$;
create trigger case_fact_proposals_touch
before update on public.case_fact_proposals
for each row execute function public.touch_case_fact_proposal();

create or replace function public.apply_case_fact_proposal(
  p_proposal_id uuid,
  p_action text,
  p_patch jsonb default '{}'::jsonb,
  p_expected_updated_at timestamptz default null,
  p_note text default ''
)
returns jsonb
language plpgsql
security definer
set search_path = public
as $$
declare
  v_proposal public.case_fact_proposals%rowtype;
  v_label text;
  v_value text;
  v_normalized numeric;
  v_currency text;
  v_period text;
  v_definition text;
  v_type text;
  v_previous public.deal_claims%rowtype;
  v_claim_id uuid;
  v_status text;
  v_action text;
  v_before jsonb;
  v_after jsonb;
begin
  if auth.uid() is null or not public.can_write_project() then
    raise exception 'You need project write access to review proposed facts.' using errcode = '42501';
  end if;
  if p_action not in ('accept','edit','reject') then
    raise exception 'Invalid proposal review action.' using errcode = '22023';
  end if;

  select * into v_proposal from public.case_fact_proposals where id = p_proposal_id for update;
  if not found then
    return jsonb_build_object('status', 'not_found');
  end if;
  if v_proposal.status <> 'pending' then
    return jsonb_build_object('status', v_proposal.status, 'idempotent', true, 'proposal_id', v_proposal.id);
  end if;
  if p_expected_updated_at is not null and v_proposal.updated_at is distinct from p_expected_updated_at then
    return jsonb_build_object('status', 'stale', 'proposal_id', v_proposal.id, 'updated_at', v_proposal.updated_at);
  end if;

  v_before := jsonb_build_object(
    'label', v_proposal.label, 'value_text', v_proposal.value_text,
    'normalized_value', v_proposal.normalized_value, 'currency', v_proposal.currency,
    'reporting_period', v_proposal.reporting_period, 'metric_definition', v_proposal.metric_definition,
    'claim_type', v_proposal.claim_type, 'status', v_proposal.status
  );

  if p_action = 'reject' then
    update public.case_fact_proposals
    set status = 'rejected', review_note = left(coalesce(p_note, ''), 2000), reviewed_by = auth.uid(), reviewed_at = now(), updated_at = now()
    where id = v_proposal.id;
    insert into public.case_fact_reviews (proposal_id, action, before, after, note, reviewer)
    values (v_proposal.id, 'reject', v_before, jsonb_build_object('status', 'rejected'), left(coalesce(p_note, ''), 2000), auth.uid());
    return jsonb_build_object('status', 'rejected', 'proposal_id', v_proposal.id);
  end if;

  v_label := left(coalesce(nullif(p_patch->>'label', ''), v_proposal.label), 160);
  v_value := left(coalesce(nullif(p_patch->>'value_text', ''), v_proposal.value_text), 240);
  v_normalized := coalesce(nullif(p_patch->>'normalized_value', '')::numeric, v_proposal.normalized_value);
  v_currency := left(upper(coalesce(nullif(p_patch->>'currency', ''), v_proposal.currency)), 3);
  v_period := left(coalesce(p_patch->>'reporting_period', v_proposal.reporting_period), 80);
  v_definition := left(coalesce(p_patch->>'metric_definition', v_proposal.metric_definition), 240);
  v_type := coalesce(nullif(p_patch->>'claim_type', ''), v_proposal.claim_type);
  if v_label = '' or v_value = '' then
    raise exception 'A proposal needs a label and value before approval.' using errcode = '22023';
  end if;

  if v_proposal.previous_claim_id is not null then
    select * into v_previous from public.deal_claims where id = v_proposal.previous_claim_id and deal_id = v_proposal.deal_id;
  end if;

  insert into public.deal_claims (
    deal_id, claim_type, label, supporting_excerpt, value_text, normalized_value, currency,
    reporting_period, metric_definition, verification_status, review_status, reviewed_by, reviewed_at,
    claim_key, file_name, document_id, source_id, superseded_by, proposed_change_to,
    verification_note, attribution, created_by
  ) values (
    v_proposal.deal_id, v_type, v_label, v_proposal.source_excerpt, v_value, v_normalized, v_currency,
    v_period, v_definition,
    case v_proposal.attribution when 'founder' then 'founder_reported' when 'third_party' then 'unverified' else 'unverified' end,
    'approved', auth.uid(), now(),
    lower(regexp_replace(v_label, '[^a-zA-Z0-9]+', '_', 'g')) || '__' || lower(regexp_replace(v_period, '[^a-zA-Z0-9]+', '_', 'g')),
    v_proposal.source_title, v_proposal.source_document_id, v_proposal.source_capture_id, null,
    case when v_proposal.relation in ('changed','conflict') then v_proposal.previous_claim_id else null end,
    'Approved from source-linked proposal ' || v_proposal.id::text || '.', v_proposal.attribution, auth.uid()
  ) returning id into v_claim_id;

  if v_proposal.previous_claim_id is not null and v_proposal.relation in ('changed','conflict') then
    update public.deal_claims set superseded_by = v_claim_id, updated_at = now() where id = v_proposal.previous_claim_id;
  end if;

  v_action := case when p_action = 'edit' then 'edit' else 'accept' end;
  update public.case_fact_proposals
  set status = case when v_action = 'edit' then 'accepted' else 'accepted' end,
      edited = (v_action = 'edit'),
      label = v_label, value_text = v_value, normalized_value = v_normalized, currency = v_currency,
      reporting_period = v_period, metric_definition = v_definition, claim_type = v_type,
      review_note = left(coalesce(p_note, ''), 2000), reviewed_by = auth.uid(), reviewed_at = now(),
      applied_claim_id = v_claim_id, updated_at = now()
  where id = v_proposal.id;

  insert into public.case_fact_reviews (proposal_id, action, before, after, note, reviewer)
  values (
    v_proposal.id, v_action, v_before,
    jsonb_build_object('label', v_label, 'value_text', v_value, 'normalized_value', v_normalized,
      'currency', v_currency, 'reporting_period', v_period, 'metric_definition', v_definition,
      'claim_type', v_type, 'status', 'accepted', 'claim_id', v_claim_id),
    left(coalesce(p_note, ''), 2000), auth.uid()
  );

  return jsonb_build_object('status', 'accepted', 'edited', (v_action = 'edit'), 'proposal_id', v_proposal.id, 'claim_id', v_claim_id);
end;
$$;

revoke all on function public.snapshot_deal_memo_version() from public, anon, authenticated;
revoke all on function public.touch_case_fact_proposal() from public, anon, authenticated;
revoke all on function public.apply_case_fact_proposal(uuid, text, jsonb, timestamptz, text) from public, anon;
grant execute on function public.apply_case_fact_proposal(uuid, text, jsonb, timestamptz, text) to authenticated;