create unique index if not exists deal_memos_generation_request_idx
  on public.deal_memos (generation_request_id)
  where generation_request_id is not null;

create table if not exists public.deal_memo_versions (
  id uuid primary key default gen_random_uuid(),
  memo_id uuid not null references public.deal_memos(id) on delete restrict,
  deal_id uuid not null references public.deals(id) on delete cascade,
  version_number integer not null check (version_number > 0),
  title text not null default '',
  content text not null default '',
  origin text not null default 'manual',
  generation_model text not null default '',
  source_ids uuid[] not null default '{}'::uuid[],
  approved_proposal_ids uuid[] not null default '{}'::uuid[],
  human_edited boolean not null default false,
  edited_by uuid,
  created_by uuid,
  created_at timestamptz not null default now(),
  unique (memo_id, version_number)
);
create index if not exists deal_memo_versions_deal_idx on public.deal_memo_versions (deal_id, created_at desc);
alter table public.deal_memo_versions enable row level security;

insert into public.deal_memo_versions (memo_id, deal_id, version_number, title, content, origin, generation_model, source_ids, approved_proposal_ids, human_edited, edited_by, created_by, created_at)
select id, deal_id, 1, title, content, coalesce(origin, 'manual'), coalesce(generation_model, ''), coalesce(source_ids, '{}'::uuid[]), coalesce(approved_proposal_ids, '{}'::uuid[]), coalesce(human_edited, false), edited_by, coalesce(updated_by, created_by), updated_at
from public.deal_memos
where not exists (select 1 from public.deal_memo_versions v where v.memo_id = deal_memos.id);

create or replace function public.snapshot_deal_memo_version()
returns trigger
language plpgsql
security definer
set search_path = public
as $$
declare
  v_next integer;
begin
  if tg_op = 'UPDATE'
     and new.content is not distinct from old.content
     and new.title is not distinct from old.title
     and new.origin is not distinct from old.origin
     and new.generation_model is not distinct from old.generation_model
     and new.source_ids is not distinct from old.source_ids
     and new.approved_proposal_ids is not distinct from old.approved_proposal_ids
     and new.human_edited is not distinct from old.human_edited then
    return new;
  end if;

  select coalesce(max(version_number), 0) + 1 into v_next
  from public.deal_memo_versions where memo_id = new.id;

  insert into public.deal_memo_versions (
    memo_id, deal_id, version_number, title, content, origin, generation_model,
    source_ids, approved_proposal_ids, human_edited, edited_by, created_by
  ) values (
    new.id, new.deal_id, v_next, new.title, new.content, coalesce(new.origin, 'manual'),
    coalesce(new.generation_model, ''), coalesce(new.source_ids, '{}'::uuid[]),
    coalesce(new.approved_proposal_ids, '{}'::uuid[]), coalesce(new.human_edited, false),
    new.edited_by, coalesce(new.updated_by, new.created_by)
  );
  return new;
end;
$$;

create trigger deal_memos_snapshot_version
after insert or update on public.deal_memos
for each row execute function public.snapshot_deal_memo_version();

create policy deal_memo_versions_member_select on public.deal_memo_versions
for select to authenticated using (public.is_project_member());

create table if not exists public.case_fact_proposals (
