alter table public.deal_claims add column if not exists metric_definition text not null default '';

alter table public.deal_memos
  add column if not exists origin text not null default 'manual',
  add column if not exists generation_model text not null default '',
  add column if not exists source_ids uuid[] not null default '{}'::uuid[],
  add column if not exists approved_proposal_ids uuid[] not null default '{}'::uuid[],
  add column if not exists human_edited boolean not null default false,
