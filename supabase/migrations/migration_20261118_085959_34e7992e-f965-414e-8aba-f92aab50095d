create table public.deal_people (
  id uuid primary key default gen_random_uuid(),
  deal_id uuid not null references public.deals(id) on delete cascade,
  name text not null,
  title text not null default '',
  email text,
  role text not null default 'founder' check (role in ('founder','contact','other')),
  source_document_id uuid references public.case_documents(id) on delete set null,
  source_excerpt text not null default '',
  created_by uuid default auth.uid(),
  created_at timestamptz not null default now(),
  updated_at timestamptz not null default now()
);
create index deal_people_deal_idx on public.deal_people (deal_id, name);
alter table public.deal_people enable row level security;
create policy deal_people_select on public.deal_people for select to authenticated using (public.is_project_member());
create policy deal_people_insert on public.deal_people for insert to authenticated with check (public.can_write_project());
create policy deal_people_update on public.deal_people for update to authenticated using (public.can_write_project()) with check (public.can_write_project());
